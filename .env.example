# ══════════════════════════════════════════════════════════════════════════
# Desivdesi Backend — environment variable template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ══════════════════════════════════════════════════════════════════════════

# ── Core / pre-existing ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGODB_URI=                       # mongodb+srv://... (Atlas) or mongodb://localhost:27017/desivdesi
JWT_SECRET=                        # long random string — used to sign all auth tokens (customer + staff)
JWT_EXPIRES_IN=1d                  # optional, defaults to 1d if unset
FRONTEND_URL=http://localhost:5173 # used in email templates/links; set to your deployed frontend URL in production

# ── Cloudinary (image/PDF uploads — packages, hotels, blog, reviews, avatars) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Gmail transporter — utils/email.js) ───────────────────────────
# NOTE: utils/email.js authenticates with EMAIL_USER/EMAIL_PASS via Gmail's
# SMTP service. If you intended to use a different SMTP provider, update
# utils/email.js's transporter config accordingly — the SMTP_* names below
# are not currently read by any code and are safe to ignore unless you wire
# them in yourself.
EMAIL_USER=                        # Gmail address bookings/notifications are sent from
EMAIL_PASS=                        # Gmail App Password (not your normal account password)
EMAIL_FROM=                        # optional "From" display address, currently unused by code
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=

# ── Third-party APIs (pre-existing) ──────────────────────────────────────
GOOGLE_PLACES_API_KEY=             # Places autocomplete (Places.controller.js)
GEMINI_API_KEY=                    # AI Trip Planner itinerary generation
RAPIDAPI_KEY=                      # IRCTC live-station + hotel search (RapidAPI)

# ── Admin seed script (Backend/admin.js — Part A fix) ────────────────────
# Required before running: node admin.js
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Admin

# ── Payment Gateway — Razorpay (Part B, Module 5 / Part C checkout) ──────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=           # from the Razorpay Dashboard webhook config — required for /api/payments/webhook

# ── Admin notification "From" identity (Part B, Notification Center) ─────
ADMIN_EMAIL=bookings@desivdesi.com # falls back to this if unset — used as a generic sender identity in a few templates

# ── Optional operational tuning ───────────────────────────────────────────
# MAX_FILE_SIZE_MB=10
# ALLOWED_IPS=                     # comma-separated allowlist, only relevant if you add IP-restriction middleware
